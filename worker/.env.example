# Your own Supabase backend (renamed to avoid reserved Lovable prefixes).
BOT_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
BOT_SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
YELLOWSTONE_GRPC_URL=https://laserstream-mainnet-ewr.helius-rpc.com
YELLOWSTONE_TOKEN=YOUR_HELIUS_API_KEY

# Paid Jupiter developer key. Used by current Price API v3 and the official
# Swap endpoint; the lite swap endpoint remains a fallback.
JUPITER_API_KEY=YOUR_JUPITER_API_KEY
PRICE_API_URL=https://api.jup.ag/price/v3

